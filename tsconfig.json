{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["apps/web"],
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "apps/**/*.ts"
  ]
}
