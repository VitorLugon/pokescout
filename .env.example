# Local development only. Replace the example password before starting.
POSTGRES_USER=pokescout
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=pokescout
POSTGRES_PORT=55432
DATABASE_URL=postgresql://pokescout:replace_with_local_password@localhost:55432/pokescout
# Dedicated test schema created inside this database; never point at production.
# TEST_DATABASE_URL=postgresql://pokescout:replace_with_local_password@localhost:55432/pokescout

# API defaults to loopback locally. Set API_HOST=0.0.0.0 in Render.
# API_HOST=127.0.0.1
# Port precedence: API_PORT, then the hosting platform's PORT, then 3001.
# API_PORT=3001
